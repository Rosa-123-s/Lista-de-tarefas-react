import React, { useState } from "react";
import {
  CheckCircle,
  Trash2,
  Pencil,
  PlusCircle,
} from "lucide-react";

export default function App() {
  const [tarefas, setTarefas] = useState([]);
  const [novaTarefa, setNovaTarefa] = useState("");
  const [editandoId, setEditandoId] = useState(null);
  const [textoEditado, setTextoEditado] = useState("");

  // Adicionar tarefa
  function adicionarTarefa() {
    if (novaTarefa.trim() === "") {
      alert("Digite uma tarefa!");
      return;
    }

    const tarefa = {
      id: Date.now(),
      texto: novaTarefa,
      concluida: false,
    };

    setTarefas([...tarefas, tarefa]);
    setNovaTarefa("");
  }

  // Concluir tarefa
  function concluirTarefa(id) {
    const novasTarefas = tarefas.map((tarefa) => {
      if (tarefa.id === id) {
        return {
          ...tarefa,
          concluida: !tarefa.concluida,
        };
      }
      return tarefa;
    });

    setTarefas(novasTarefas);
  }

  // Remover tarefa
  function removerTarefa(id) {
    const novasTarefas = tarefas.filter(
      (tarefa) => tarefa.id !== id
    );

    setTarefas(novasTarefas);
  }

  // Salvar edição
  function salvarEdicao(id) {
    const novasTarefas = tarefas.map((tarefa) => {
      if (tarefa.id === id) {
        return {
          ...tarefa,
          texto: textoEditado,
        };
      }
      return tarefa;
    });

    setTarefas(novasTarefas);
    setEditandoId(null);
  }

  return (
    <div style={styles.container}>
      <div style={styles.card}>
        <h1 style={styles.titulo}>Lista de Tarefas</h1>

        {/* Input */}
        <div style={styles.inputArea}>
          <input
            type="text"
            placeholder="Digite uma tarefa..."
            value={novaTarefa}
            onChange={(e) =>
              setNovaTarefa(e.target.value)
            }
            style={styles.input}
          />

          <button
            onClick={adicionarTarefa}
            style={styles.addButton}
          >
            <PlusCircle size={28} />
          </button>
        </div>

        {/* Lista */}
        <div>
          {tarefas.map((tarefa) => (
            <div
              key={tarefa.id}
              style={{
                ...styles.tarefaCard,
                backgroundColor: tarefa.concluida
                  ? "#d4f8d4"
                  : "#f5f5f5",
              }}
            >
              <div style={{ flex: 1 }}>
                {editandoId === tarefa.id ? (
                  <input
                    type="text"
                    value={textoEditado}
                    onChange={(e) =>
                      setTextoEditado(e.target.value)
                    }
                    style={styles.editInput}
                  />
                ) : (
                  <p
                    style={{
                      ...styles.textoTarefa,
                      textDecoration:
                        tarefa.concluida
                          ? "line-through"
                          : "none",
                      color: tarefa.concluida
                        ? "#777"
                        : "#222",
                    }}
                  >
                    {tarefa.texto}
                  </p>
                )}
              </div>

              <div style={styles.buttonsArea}>
                {/* Concluir */}
                <button
                  onClick={() =>
                    concluirTarefa(tarefa.id)
                  }
                  style={{
                    ...styles.iconButton,
                    backgroundColor: "#22c55e",
                  }}
                >
                  <CheckCircle size={20} />
                </button>

                {/* Editar */}
                {editandoId === tarefa.id ? (
                  <button
                    onClick={() =>
                      salvarEdicao(tarefa.id)
                    }
                    style={{
                      ...styles.saveButton,
                    }}
                  >
                    Salvar
                  </button>
                ) : (
                  <button
                    onClick={() => {
                      setEditandoId(tarefa.id);
                      setTextoEditado(tarefa.texto);
                    }}
                    style={{
                      ...styles.iconButton,
                      backgroundColor: "#facc15",
                    }}
                  >
                    <Pencil size={20} />
                  </button>
                )}

                {/* Remover */}
                <button
                  onClick={() =>
                    removerTarefa(tarefa.id)
                  }
                  style={{
                    ...styles.iconButton,
                    backgroundColor: "#ef4444",
                  }}
                >
                  <Trash2 size={20} />
                </button>
              </div>
            </div>
          ))}
        </div>

        {/* Total */}
        <div style={styles.total}>
          Total de tarefas: {tarefas.length}
        </div>
      </div>
    </div>
  );
}

